#
# Embeds the dashboard (ui/) in the executable for Release builds.
# Generates ui_resources.rc (one RCDATA resource per file) and ui_resources.h
# (a table of URL path, resource ID and MIME type for WebViewHost).
# mock.js is browser-preview only and never embedded.

function(gfx_embed_ui target ui_dir)
    file(GLOB_RECURSE files RELATIVE "${ui_dir}" CONFIGURE_DEPENDS
        "${ui_dir}/*.html" "${ui_dir}/*.css" "${ui_dir}/*.js" "${ui_dir}/*.woff2" "${ui_dir}/*.txt")
    list(REMOVE_ITEM files "mock.js")
    list(SORT files)

    set(rc "// Generated by cmake/UiResources.cmake. Do not edit.\n")
    set(table "// Generated by cmake/UiResources.cmake. Do not edit.\n#pragma once\n\n")
    string(APPEND table "struct UiResource { const wchar_t* path; int id; const wchar_t* mime; };\n\n")
    string(APPEND table "inline constexpr UiResource kUiResources[] = {\n")
    set(id 2000)
    set(deps "")
    foreach(f IN LISTS files)
        math(EXPR id "${id} + 1")
        get_filename_component(ext "${f}" LAST_EXT)
        if(ext STREQUAL ".html")
            set(mime "text/html; charset=utf-8")
        elseif(ext STREQUAL ".css")
            set(mime "text/css; charset=utf-8")
        elseif(ext STREQUAL ".js")
            set(mime "text/javascript; charset=utf-8")
        elseif(ext STREQUAL ".woff2")
            set(mime "font/woff2")
        else()
            set(mime "text/plain; charset=utf-8")
        endif()
        string(APPEND rc "${id} RCDATA \"${ui_dir}/${f}\"\n")
        string(APPEND table "    {L\"/${f}\", ${id}, L\"${mime}\"},\n")
        list(APPEND deps "${ui_dir}/${f}")
    endforeach()
    string(APPEND table "};\n")

    set(out "${CMAKE_CURRENT_BINARY_DIR}/generated")
    file(CONFIGURE OUTPUT "${out}/ui_resources.rc" CONTENT "${rc}")
    file(CONFIGURE OUTPUT "${out}/ui_resources.h" CONTENT "${table}")

    target_sources(${target} PRIVATE "${out}/ui_resources.rc")
    target_include_directories(${target} PRIVATE "${out}")
    # Rebuild the resources when any UI file changes.
    set_source_files_properties("${out}/ui_resources.rc" PROPERTIES OBJECT_DEPENDS "${deps}")
endfunction()
